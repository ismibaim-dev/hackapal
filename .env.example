# Copy this file to .env and fill it in. .env is git-ignored: never commit real values.
#   PowerShell:  Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env

# --- PayPal (sandbox only) ---------------------------------------------------
# developer.paypal.com > Apps & Credentials (Sandbox) > your app
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the sandbox webhook that points at ${PUBLIC_BASE_URL}/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# --- Server ------------------------------------------------------------------
# Where PayPal sends the buyer back after approval.
# Local: http://localhost:3000   Render: https://<service>.onrender.com
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# --- Optional: seller ping on Telegram ----------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
