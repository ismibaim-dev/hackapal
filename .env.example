# Copy this file to .env and fill it in. .env is git-ignored: never commit real values.
#   PowerShell:  Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env

# --- PayPal (sandbox only) ---------------------------------------------------
# developer.paypal.com > Apps & Credentials (Sandbox) > your app
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the sandbox webhook that points at ${PUBLIC_BASE_URL}/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# --- Server ------------------------------------------------------------------
# Where PayPal sends the buyer back after approval.
# Local: http://localhost:3000   Render: leave unset (falls back to RENDER_EXTERNAL_URL)
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# --- Internal API ------------------------------------------------------------
# Long random string (24+ chars). /api/* needs it as "Authorization: Bearer <key>";
# without it /api is switched off. money-path sends HACKAPAL_API_KEY (or API_KEY).
API_KEY=

# --- Order store (optional locally; without it orders live in memory) ----------
# Supabase project "hackapal": Settings > API Keys > Secret keys (sb_secret_...). Server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Optional: seller ping on Telegram ----------------------------------------
TELEGRAM_BOT_TOKEN=
# Default chat: shops without their own chat use this one.
TELEGRAM_CHAT_ID=
# Each shop's own chat, e.g. kampung-fresh-mart=-1001234567890,kilat-home-cleaning=-1009876543210
TELEGRAM_SHOP_CHATS=
